# Xcode
#
# gitignore template for Xcode / Swift projects
# Recommended by GitHub and Apple developer community

## User Data and Workspace Settings
# Ignore personal scheme settings, breakpoints, and UI state
xcuserdata/
*.xcuserdatad/
*.xcscmblueprint
*.xccheckout

## Build and Derived Data
build/
DerivedData/
*.moved-aside
*.xcuserstate

## Objective-C / Swift Autogenerated headers
*-Swift.h

## Playgrounds
timeline.xctimeline
playground.xcworkspace

## Swift Package Manager
# Ignore build artifacts generated by SPM
.build/
Packages/
Package.pins
Package.resolved
# Note: If developing an application (iOS/macOS App), checking in Package.resolved
# is recommended to lock dependency versions across teammates.
# Uncomment the line below to track Package.resolved:
# !Package.resolved

## CocoaPods
# Ignore CocoaPods build directories and artifacts
Pods/
*.xcworkspace
# Note: If your project uses CocoaPods, uncomment the line below
# so the main workspace is tracked by git:
# !*.xcworkspace

## Carthage
# Ignore Carthage build directories
Carthage/Build/
Carthage/Checkouts/

## Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

## App Store & Deployment
*.ipa
*.dSYM.zip
*.dSYM

## macOS System Files
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
